# Shopify Global Catalog credentials (from the Shopify Dev Dashboard)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Publicly hosted UCP agent profile JSON (e.g. GitHub Pages / raw gist URL)
AGENT_PROFILE_URL=

# LLM access (OpenRouter by default; see LLM_PROVIDER)
LLM_API_KEY=

# Optional overrides (defaults shown)
# LLM_PROVIDER=openrouter        # openrouter | anthropic | openai
# LLM_MODEL=anthropic/claude-opus-4-8
# MCP_ENDPOINT=https://catalog.shopify.com/api/ucp/mcp
# AUTH_ENDPOINT=https://api.shopify.com/auth/access_token
